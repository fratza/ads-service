# Server Configuration
PORT=4000
NODE_ENV=development
ENABLE_LOGGING=true

# Backend API Configuration
API_BASE_URL=https://your-backend-api.com
API_TIMEOUT=30000

# Production Origin Validation (for production environments)
ALLOWED_ORIGIN=https://yourdomain.com

# Creatomate server-side integration
# Keep this value on the server. Never expose it in Angular environment files.
CREATOMATE_API_KEY=
# Public token used by the browser-based Creatomate Preview SDK.
CREATOMATE_PLAYER_TOKEN=

# Server-only SkillHub credentials used by the Creatomate template mapper.
SKILLHUB_URL=http://3.219.184.254:4200/api/ai/skills
SKILLHUB_API_KEY=
# Server-only OpenAI credentials used by the Creatomate AI JSON template editor
# (prompt-based edits to a template's JSON source, including animations).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: allows trusted systems to submit advertisement requests without a browser origin.
ADVERTISEMENT_INGESTION_API_KEY=
# Supabase Storage (server only). Keep the service role key out of browser code.
SUPABASE_URL=https://zvtxdlbnnnkbytkqksjq.supabase.co
SUPABASE_STORAGE_BUCKET=dealer-ads
SUPABASE_STORAGE_PUBLIC=true
SUPABASE_SERVICE_ROLE_KEY=
# n8n webhook (server only) that triggers the trivia video generation workflow.
# The webhook responds once the whole batch's videos are generated and the
# Remotion render job is created, so this call can take several minutes.
N8N_TRIVIA_WEBHOOK_URL=
# trivias-api.onrender.com auth used to poll trivia render job status.
TRIVIAS_API_KEY=
