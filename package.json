{
    "name": "ng-scaffolding",
    "version": "1.2.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr:ng-scaffolding": "node dist/ng-scaffolding/server/server.mjs",
        "pretty": "prettier --write \"./**/*.{html,js,jsx,mjs,cjs,ts,tsx,json,scss,css}\"",
